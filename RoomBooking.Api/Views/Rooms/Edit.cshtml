@model RoomBooking.Domain.Entities.RoomEntity

@{
    ViewData["Title"] = "Редагування залу";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4 shadow-sm mb-4">
            <h3 class="fw-bold mb-3">Редагування: @Model.Name</h3>

            <form asp-action="Edit" method="post">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Назва залу:</label>
                    <input type="text" name="name" class="form-control" value="@Model.Name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Базова погодинна ставка (грн/год):</label>
                    <input type="number" step="0.01" min="0" name="basePricePerHour" class="form-control" value="@Model.BasePricePerHour" required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Зберегти зміни</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Назад до списку</a>
                </div>
            </form>
        </div>

        <div class="card p-4 shadow-sm">
            <h4 class="fw-bold mb-3">Додати послугу до залу</h4>

            <form asp-action="AddService" method="post" class="row g-3">
                <input type="hidden" name="roomId" value="@Model.Id" />

                <div class="col-md-6">
                    <input type="text" name="serviceName" class="form-control" placeholder="Назва (напр. Звукове обладнання)" required />
                </div>
                <div class="col-md-4">
                    <input type="number" step="0.01" min="0" name="servicePrice" class="form-control" placeholder="Ціна (грн)" required />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100">+ Додати</button>
                </div>
            </form>

            <h5 class="fw-semibold mt-4 mb-2">Наявні послуги:</h5>
            @if (Model.AvailableServices.Any())
            {
                <ul class="list-group">
                    @foreach (var s in Model.AvailableServices)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@s.Name</span>
                            <span class="badge bg-secondary rounded-pill">@s.Price.ToString("N2") грн</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small mb-0">Послуг ще не додано.</p>
            }
        </div>
    </div>
</div>