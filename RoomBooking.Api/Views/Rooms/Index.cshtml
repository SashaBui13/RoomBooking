@model IEnumerable<RoomBooking.Domain.Entities.RoomEntity>

@{
    ViewData["Title"] = "Конференц-зали";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 fw-bold mb-0">Список конференц-залів</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">+ Створити зал</a>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center bg-white shadow-sm">
        <h4 class="text-secondary fw-normal">Залів ще не створено</h4>
        <p class="text-muted">Створіть перший конференц-зал, щоб почати роботу із системою.</p>
        <div>
            <a asp-action="Create" class="btn btn-outline-primary mt-2">Додати зал</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var room in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 p-3">
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title fw-bold text-dark">@room.Name</h4>
                        <div class="mb-3 text-muted">
                            <div><strong>Місткість:</strong> @room.Capacity осіб</div>
                            <div><strong>Базова ціна:</strong> @room.BasePricePerHour.ToString("N2") грн/год</div>
                        </div>

                        <h6 class="fw-semibold text-secondary">Додаткові послуги:</h6>
                        <ul class="list-unstyled flex-grow-1">
                            @if (room.AvailableServices.Any())
                            {
                                @foreach (var service in room.AvailableServices)
                                {
                                    <li class="badge bg-light text-dark border me-1 mb-1 p-2">
                                        @service.Name: @service.Price.ToString("N2") грн
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="text-muted small">Послуги відсутні</li>
                            }
                        </ul>

                        <div class="d-flex gap-2 mt-3 pt-3 border-top">
                            <a asp-action="Edit" asp-route-id="@room.Id" class="btn btn-outline-secondary w-50">Редагувати</a>
                            <form asp-action="Delete" asp-route-id="@room.Id" method="post" class="w-50" onsubmit="return confirm('Видалити зал?');">
                                <button type="submit" class="btn btn-outline-danger w-100">Видалити</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}