@{
    ViewData["Title"] = "Аналітика та звіти";
}

<h2 class="fw-bold mb-4">Звіти та показники</h2>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm border-0 bg-primary text-white">
            <h5 class="card-title text-white-50">Загальний дохід</h5>
            <h2 class="display-6 fw-bold">@ViewBag.TotalRevenue.ToString("N2") грн</h2>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-4 shadow-sm border-0 bg-dark text-white">
            <h5 class="card-title text-white-50">Кількість оформлених бронювань</h5>
            <h2 class="display-6 fw-bold">@ViewBag.TotalBookings</h2>
        </div>
    </div>
</div>

<div class="card p-4 shadow-sm border-0">
    <h4 class="fw-bold mb-3">Популярність залів</h4>
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Назва залу</th>
                <th>Кількість бронювань</th>
                <th>Загальний дохід</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ViewBag.PopularRooms)
            {
                <tr>
                    <td class="fw-bold">@item.RoomName</td>
                    <td>@item.BookingCount</td>
                    <td class="text-success fw-semibold">@item.Revenue.ToString("N2") грн</td>
                </tr>
            }
        </tbody>
    </table>
</div>